<Window x:Class="PhanMemBanHang.View.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Highlands Coffee - Hóa đơn"
        Width="650"
        Height="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">

            <Border x:Name="receiptBorder"
                    Width="560"
                    HorizontalAlignment="Center"
                    Background="White"
                    CornerRadius="12"
                    Padding="35">

                <StackPanel>

                    <!-- HEADER -->
                    <TextBlock Text="HIGHLANDS COFFEE"
                               HorizontalAlignment="Center"
                               FontSize="31"
                               FontWeight="Bold"
                               Foreground="#B12026"/>

                    <TextBlock Text="COFFEE"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               Foreground="#333333"
                               Margin="0,-2,0,5"/>

                    <TextBlock Text="HÓA ĐƠN BÁN HÀNG"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,5,0,18"/>

                    <Border Height="1"
                            Background="#AAAAAA"
                            Margin="0,0,0,18"/>

                    <!-- THÔNG TIN -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="31"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Mã hóa đơn:"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtMaHD"
                                   Grid.Row="0"
                                   Grid.Column="1"/>

                        <TextBlock Grid.Row="1"
                                   Text="Thời gian:"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtThoiGian"
                                   Grid.Row="1"
                                   Grid.Column="1"/>

                        <TextBlock Grid.Row="2"
                                   Text="Nhân viên:"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtNhanVien"
                                   Grid.Row="2"
                                   Grid.Column="1"/>

                        <TextBlock Grid.Row="3"
                                   Text="Khách hàng:"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtKhachHang"
                                   Grid.Row="3"
                                   Grid.Column="1"/>

                        <TextBlock Grid.Row="4"
                                   Text="Loại đơn:"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtLoaiDon"
                                   Grid.Row="4"
                                   Grid.Column="1"/>

                        <TextBlock Grid.Row="5"
                                   Text="Thanh toán:"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtPhuongThuc"
                                   Grid.Row="5"
                                   Grid.Column="1"/>
                    </Grid>

                    <Border Height="1"
                            Background="#AAAAAA"
                            Margin="0,12,0,15"/>

                    <!-- HEADER SẢN PHẨM -->
                    <Grid Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Sản phẩm"
                                   FontWeight="Bold"/>

                        <TextBlock Grid.Column="1"
                                   Text="SL"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="Đơn giá"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Column="3"
                                   Text="Thành tiền"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                    <!-- ITEMS -->
                    <ItemsControl x:Name="itemsHoaDon">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0,5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="105"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TenHienThi}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SoLuong}"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DonGia, StringFormat={}{0:N0}đ}"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ThanhTien, StringFormat={}{0:N0}đ}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Border Height="1"
                            Background="#AAAAAA"
                            Margin="0,14,0,14"/>

                    <!-- TỔNG -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="31"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Tạm tính"/>

                        <TextBlock x:Name="txtTamTinh"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1"
                                   Text="Giảm giá"/>

                        <TextBlock x:Name="txtGiamGia"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2"
                                   Text="TỔNG THANH TOÁN"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="txtThanhTien"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#B12026"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>

                    </Grid>

                    <!-- QR -->
                    <StackPanel x:Name="qrPanel"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                Margin="0,15,0,0">

                        <Border Height="1"
                                Width="480"
                                Background="#DDDDDD"
                                Margin="0,0,0,15"/>

                        <TextBlock Text="THANH TOÁN CHUYỂN KHOẢN"
                                   FontWeight="Bold"
                                   Foreground="#B12026"
                                   FontSize="14"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Quét QR bằng ứng dụng ngân hàng"
                                   Foreground="#777777"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,10"/>

                        <Border BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="7">

                            <Image x:Name="imgQR"
                                   Width="175"
                                   Height="175"
                                   Stretch="Uniform"/>

                        </Border>

                        <TextBlock x:Name="txtSoTienQR"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#B12026"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,0"/>

                        <TextBlock x:Name="txtNoiDungCK"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                    <Border Height="1"
                            Background="#DDDDDD"
                            Margin="0,20,0,15"/>

                    <TextBlock Text="Cảm ơn quý khách đã lựa chọn Highlands Coffee!"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"
                               Foreground="#777777"/>

                    <TextBlock Text="Hẹn gặp lại quý khách!"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"
                               Foreground="#777777"
                               Margin="0,3,0,0"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- BUTTON -->
        <Grid Grid.Row="1"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Height="48"
                    Content="💾  Lưu TXT"
                    Click="LuuTxt_Click"/>

            <Button Grid.Column="2"
                    Height="48"
                    Content="🖨  In hóa đơn"
                    Click="InHoaDon_Click"/>

            <Button Grid.Column="4"
                    Height="48"
                    Content="Đóng"
                    Click="Dong_Click"/>

        </Grid>

    </Grid>

</Window>