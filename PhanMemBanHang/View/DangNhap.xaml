<Window x:Class="PhanMemBanHang.View.DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhanMemBanHang.ViewModel"
        mc:Ignorable="d"
        Title="Highlands Coffee - Đăng nhập"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <!-- TextBox hiện đại với animation -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#B22222"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#C0C0C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button hiện đại với gradient và animation -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#B22222" Offset="0"/>
                        <GradientStop Color="#D32F2F" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#A01F1F" Offset="0"/>
                                            <GradientStop Color="#C62828" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#8B1A1A" Offset="0"/>
                                            <GradientStop Color="#B71C1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Width="45" Height="45"
                                CornerRadius="22.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="Foreground" Value="#B22222"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Refresh Button Style -->
        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                    <Setter Property="BorderBrush" Value="#B22222"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel trái với gradient -->
            <Border Grid.Column="0" CornerRadius="25,0,0,25">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B22222" Offset="0"/>
                        <GradientStop Color="#8B1A1A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Logo với border -->
                        <Border Background="White" 
                                CornerRadius="80" 
                                Width="160" 
                                Height="160"
                                Margin="0,0,0,35">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="Black"/>
                            </Border.Effect>
                            <Image Source="/Image/logo.png"
                                   Width="140"
                                   Height="140"
                                   Stretch="Uniform"/>
                        </Border>

                        <TextBlock Text="HIGHLANDS" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="COFFEE" 
                                   FontSize="32" 
                                   FontWeight="Light"
                                   FontFamily="Segoe UI"
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,40"/>

                        <Border CornerRadius="15" Padding="30,20"
                                Margin="40,0" Width="294">
                            <StackPanel>
                                <TextBlock Text="Chào mừng bạn đến với" 
                                           FontSize="15"
                                           FontFamily="Segoe UI"
                                           Foreground="White" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Hệ thống quản lý bán hàng" 
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"
                                           Foreground="White" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Panel phải -->
            <Grid Grid.Column="1" Margin="60,20,60,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Close Button -->
                <Button x:Name="btn_Close"
                        Style="{StaticResource CloseButton}"
                        Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-10,-10,0"
                        Click="Btn_Close"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <!-- Header -->
                    <TextBlock Text="Đăng nhập"
                               FontSize="32"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Foreground="#2C3E50"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Vui lòng nhập thông tin để tiếp tục"
                               FontSize="14"
                               FontFamily="Segoe UI"
                               Foreground="#7F8C8D"
                               Margin="0,0,0,40"/>

                    <!-- Tên đăng nhập -->
                    <TextBlock Text="TÊN ĐĂNG NHẬP"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="#5D6D7E"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="txtTenDangNhap"
                             Text="{Binding TaiKhoan, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,25"/>

                    <!-- Mật khẩu -->
                    <TextBlock Text="MẬT KHẨU"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="#5D6D7E"
                               Margin="0,0,0,10"/>

                    <!-- Nếu muốn dùng PasswordBox thì thay TextBox này -->
                    <TextBox x:Name="txtMatKhau"
                         Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,25"/>


                    <!-- CAPTCHA -->
                    <TextBlock Text="MÃ XÁC NHẬN"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="#5D6D7E"
                               Margin="0,0,0,10"/>

                    <Grid Height="50" Margin="0,0,0,35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <!-- CAPTCHA Display -->
                        <Border Grid.Column="0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="2"
                                CornerRadius="12"
                                Background="#F8F9FA">
                            <TextBlock Text="{Binding CurrentCaptcha}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       FontFamily="Courier New"
                                       Foreground="#2C3E50"/>
                        </Border>

                        <!-- CAPTCHA Input -->
                        <TextBox x:Name="txtMaXacNhan"
                                 Text="{Binding MaXacNhan, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="50"
                                 Margin="12,0"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 FontFamily="Courier New"/>

                        <!-- Refresh Button (KHÔNG dùng Command nữa) -->
                        <Button Grid.Column="2"
                                x:Name="btnRefreshCaptcha"
                                Width="55"
                                Height="50"
                                Style="{StaticResource RefreshButton}"
                                ToolTip="Tạo mã mới"
                                Click="Btn_RefreshCaptcha_Click">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                          Fill="#B22222"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- Login Button -->
                    <Button Content="ĐĂNG NHẬP"
                            Style="{StaticResource ModernButton}"
                            Height="55"
                            FontSize="15"
                            Margin="0,0,0,25"
                            IsDefault="True"
                            Click="Btn_DangNhap_Click"/>

                    <!-- Forgot Password -->
                    <Label MouseDoubleClick="QuenMatKhau">
                        <Hyperlink TextDecorations="None"
                                   Foreground="#B22222"
                                   FontSize="14"
                                   FontFamily="Segoe UI"
                                   FontWeight="Medium">
                            <Run Text="Quên mật khẩu?"/>
                        </Hyperlink>
                    </Label>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
