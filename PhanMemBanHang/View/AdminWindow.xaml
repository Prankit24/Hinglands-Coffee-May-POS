<Window x:Class="PhanMemBanHang.View.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhanMemBanHang.View"
        mc:Ignorable="d"
        Title="Highlands Coffee - Quản Lý" 
        Height="700" 
        Width="1150"
        MinHeight="650"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Menu Button Style -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B22222"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Padding="20,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#B22222" CornerRadius="10" Width="45" Height="45" Margin="0,0,12,0">
                        <TextBlock Text="☕" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HIGHLANDS COFFEE" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#2C3E50"/>
                        <TextBlock Text="Hệ thống quản lý" 
                                   FontSize="11" 
                                   Foreground="#7F8C8D"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#E8F5E9" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32">
                            <Run Text="👤"/>
                            <Run Text="{Binding TaiKhoan}"/>
                        </TextBlock>
                    </Border>
                    <Button Content="🚪 Đăng xuất" 
                            Background="#FFEBEE" 
                            Foreground="#C62828"
                            BorderThickness="0"
                            Padding="12,8"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Btn_DangXuat">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="8" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Statistics Row -->
        <Grid Grid.Row="1" Margin="10,12,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Doanh thu -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="💰" FontSize="28" Margin="0,0,0,6"/>
                    <TextBlock Text="Doanh thu hôm nay" 
                               FontSize="11" 
                               Foreground="#888"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DoanhThu, StringFormat={}{0:N0}đ}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#B22222"/>
                </StackPanel>
            </Border>

            <!-- Đơn hàng -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="🛒" FontSize="28" Margin="0,0,0,6"/>
                    <TextBlock Text="Số đơn hôm nay" 
                               FontSize="11" 
                               Foreground="#888"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SoLuongDonHang, StringFormat={}{0} đơn}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#2E7D32"/>
                </StackPanel>
            </Border>

            <!-- Sản phẩm -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="📦" FontSize="28" Margin="0,0,0,6"/>
                    <TextBlock Text="Tổng sản phẩm" 
                               FontSize="11" 
                               Foreground="#888"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SoLuongSanPham, StringFormat={}{0} mặt hàng}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#F57C00"/>
                </StackPanel>
            </Border>

            <!-- Nhân viên -->
            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="👥" FontSize="28" Margin="0,0,0,6"/>
                    <TextBlock Text="Nhân viên" 
                               FontSize="11" 
                               Foreground="#888"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SoLuongNhanVien, StringFormat={}{0} người}" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#1976D2"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Menu Grid -->
        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="12" 
                Margin="10,8,10,10"
                Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CHỨC NĂNG QUẢN LÝ" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50"
                           Margin="8,5,0,12"/>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1 -->
                    <Button Grid.Row="0" Grid.Column="0" 
                            x:Name="btnBanHang"
                            Style="{StaticResource MenuButton}"
                            Click="BtnBanHang_Click">
                        <StackPanel>
                            <TextBlock Text="🛍️" FontSize="30" Margin="0,0,0,6"/>
                            <TextBlock Text="BÁN HÀNG" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="1" 
                            x:Name="btnSanPham"
                            Style="{StaticResource MenuButton}"
                            Click="BtnSanPham_Click">
                        <StackPanel>
                            <TextBlock Text="📦" FontSize="30" Margin="0,0,0,6"/>
                            <TextBlock Text="SẢN PHẨM" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="2" 
                            x:Name="btnNhanVien"
                            Style="{StaticResource MenuButton}"
                            Click="BtnNhanVien_Click">
                        <StackPanel>
                            <TextBlock Text="👥" FontSize="30" Margin="0,0,0,6"/>
                            <TextBlock Text="NHÂN VIÊN" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="3" 
                            x:Name="btnBaoCao"
                            Style="{StaticResource MenuButton}"
                            Click="BtnBaoCao_Click">
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="30" Margin="0,0,0,6"/>
                            <TextBlock Text="BÁO CÁO" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Row 2 -->
                    <Button Grid.Row="1" Grid.Column="0" 
                            x:Name="btnDonHang"
                            Style="{StaticResource MenuButton}"
                            Click="BtnDonHang_Click">
                        <StackPanel>
                            <TextBlock Text="💳" FontSize="30" Margin="0,0,0,6"/>
                            <TextBlock Text="ĐƠN HÀNG" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="1" 
                            Style="{StaticResource MenuButton}">
                        <StackPanel>
                            <TextBlock Text="🏪" FontSize="30" Margin="0,0,0,6"/>
                            <TextBlock Text="KHO HÀNG" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="2" 
                            Style="{StaticResource MenuButton}">
                        <StackPanel>
                            <TextBlock Text="👤" FontSize="30" Margin="0,0,0,6"/>
                            <TextBlock Text="KHÁCH HÀNG" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="3" 
                            Style="{StaticResource MenuButton}">
                        <StackPanel>
                            <TextBlock Text="⚙️" FontSize="30" Margin="0,0,0,6"/>
                            <TextBlock Text="CÀI ĐẶT" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>