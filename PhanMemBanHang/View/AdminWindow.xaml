<Window x:Class="PhanMemBanHang.View.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhanMemBanHang.View"
        mc:Ignorable="d"
        Title="Highlands Coffee - Quản Lý" 
        Height="720" 
        Width="1200"
        MinHeight="680"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F5F5F5" 
                                        CornerRadius="10" Padding="14,10" 
                                        Margin="0,0,0,16">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.FontSize="14"
                                                      TextBlock.FontWeight="Bold"
                                                      TextBlock.Foreground="#212121"/>
                                </Border>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="115"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="28,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#D32F2F" CornerRadius="12" Width="52" Height="52" Margin="0,0,16,0">
                        <TextBlock Text="☕" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HIGHLANDS COFFEE" 
                                   FontSize="20" FontWeight="Bold" Foreground="#212121"/>
                        <TextBlock Text="Hệ thống quản lý" 
                                   FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#E8F5E9" CornerRadius="10" Padding="16,10" Margin="0,0,12,-0.4" Width="202">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32">
                        <Run Text="👤 "/>
                        <Run Text="{Binding HoTen}"/>
                        <LineBreak/>
                        <Run Text="{Binding ChucVu}" FontSize="12" Foreground="#4CAF50"/>
                        </TextBlock>
                    </Border>
                    <Button Content="🚪 Đăng xuất" 
                            Background="#F5F5F5" 
                            Foreground="#424242"
                            BorderThickness="0"
                            Padding="16,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="DangXuat">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Thống kê nhanh">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFEBEE" CornerRadius="12" 
                            Padding="16" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="10" 
                                    Width="48" Height="48" Margin="0,0,12,0">
                                <TextBlock Text="💰" FontSize="24" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Doanh thu hôm nay" FontSize="11" Foreground="#C62828"/>
                                <TextBlock Text="{Binding DoanhThu, StringFormat={}{0:N0}đ}" 
                                           FontSize="18" FontWeight="Bold" Foreground="#D32F2F" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="12" 
                            Padding="16" Margin="4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="10" 
                                    Width="48" Height="48" Margin="0,0,12,0">
                                <TextBlock Text="🛒" FontSize="24" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Số đơn hôm nay" FontSize="11" Foreground="#2E7D32"/>
                                <TextBlock Text="{Binding SoLuongDonHang, StringFormat={}{0} đơn}" 
                                           FontSize="18" FontWeight="Bold" Foreground="#388E3C" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="12" 
                            Padding="16" Margin="4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="10" 
                                    Width="48" Height="48" Margin="0,0,12,0">
                                <TextBlock Text="📦" FontSize="24" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Tổng sản phẩm" FontSize="11" Foreground="#E65100"/>
                                <TextBlock Text="{Binding SoLuongSanPham, StringFormat={}{0} mặt hàng}" 
                                           FontSize="18" FontWeight="Bold" Foreground="#F57C00" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Background="#E3F2FD" CornerRadius="12" 
                            Padding="16" Margin="8,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="10" 
                                    Width="48" Height="48" Margin="0,0,12,0">
                                <TextBlock Text="👥" FontSize="24" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Nhân viên" FontSize="11" Foreground="#1565C0"/>
                                <TextBlock Text="{Binding SoLuongNhanVien, StringFormat={}{0} người}" 
                                           FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Chức năng quản lý">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" 
                            x:Name="btnBanHang"
                            Style="{StaticResource MenuButton}"
                            Click="BanHang">
                        <StackPanel>
                            <TextBlock Text="🛍️" FontSize="36" Margin="0,0,0,8" TextAlignment="Center" />
                            <TextBlock Text="BÁN HÀNG" FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Quản lý bán hàng" 
                                       FontSize="11" Foreground="#757575" 
                                       Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="1" 
                            x:Name="btnSanPham"
                            Style="{StaticResource MenuButton}"
                            Click="QuanLySanPham">
                        <StackPanel >
                            <TextBlock Text="🥤" FontSize="36" Margin="0,0,0,8" TextAlignment="Center"  />
                            <TextBlock Text="SẢN PHẨM" FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Quản lý kho sản phẩm" 
                                       FontSize="11" Foreground="#757575" 
                                       Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="2" 
                            x:Name="btnNhanVien"
                            Style="{StaticResource MenuButton}"
                            Click="QuanLyNhanVien">
                        <StackPanel>
                            <TextBlock Text="👥" FontSize="36" Margin="0,0,0,8" TextAlignment="Center" />
                            <TextBlock Text="NHÂN VIÊN" FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Quản lý nhân sự" 
                                       FontSize="11" Foreground="#757575" 
                                       Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="3" 
                            x:Name="btnBaoCao"
                            Style="{StaticResource MenuButton}"
                            Click="QuanLyBaoCao">
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="36" Margin="0,0,0,8" TextAlignment="Center" />
                            <TextBlock Text="BÁO CÁO" FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Thống kê" 
                                       FontSize="11" Foreground="#757575" 
                                       Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="0" 
                            x:Name="btnDonHang"
                            Style="{StaticResource MenuButton}"
                            Click="QuanLyDonHang">
                        <StackPanel>
                            <TextBlock Text="📦" FontSize="36" Margin="0,0,0,8" TextAlignment="Center" />
                            <TextBlock Text="ĐƠN HÀNG" FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Lịch sử đơn hàng" 
                                       FontSize="11" Foreground="#757575" 
                                       Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="1" Click="QuanLyKhoHang"
                            Style="{StaticResource MenuButton}">
                        <StackPanel>
                            <TextBlock Text="🏪" FontSize="36" Margin="0,0,0,8" TextAlignment="Center" />
                            <TextBlock Text="KHO HÀNG" FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Quản lý tồn kho" 
                                       FontSize="11" Foreground="#757575" 
                                       Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="2" Click="QuanLyKhachHang"
                            Style="{StaticResource MenuButton}">
                        <StackPanel>
                            <TextBlock Text="👤" FontSize="36" Margin="0,0,0,8" TextAlignment="Center" />
                            <TextBlock Text="KHÁCH HÀNG" FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Quản lý khách hàng" 
                                       FontSize="11" Foreground="#757575" 
                                       Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="3" Click="CaiDat"
                            Style="{StaticResource MenuButton}">
                        <StackPanel>
                            <TextBlock Text="⚙️" FontSize="36" Margin="0,0,0,8" TextAlignment="Center" />
                            <TextBlock Text="CÀI ĐẶT" FontSize="14" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Cấu hình hệ thống" 
                                       FontSize="11" Foreground="#757575" 
                                       Margin="0,4,0,0" TextAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>