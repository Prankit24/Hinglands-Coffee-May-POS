<Window x:Class="PhanMemBanHang.View.QLSanPhamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản Lý Sản Phẩm - Highlands Coffee" 
        Height="750" 
        Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F5F5F5" 
                                        CornerRadius="10" Padding="14,10" 
                                        Margin="0,0,0,16">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.FontSize="14"
                                                      TextBlock.FontWeight="Bold"
                                                      TextBlock.Foreground="#212121"/>
                                </Border>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="28,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#D32F2F" CornerRadius="12" Width="50" Height="50" Margin="0,0,16,0">
                        <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUẢN LÝ SẢN PHẨM" 
                                   FontSize="20" FontWeight="Bold" Foreground="#212121"/>
                        <TextBlock Text="HIGHLANDS COFFE - QUẢN LÝ" FontStyle="Italic"
                                   FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="Quay lại" 
                        HorizontalAlignment="Right"
                        Background="#FFEBEE" 
                        Foreground="#C62828"
                        BorderThickness="0"
                        Padding="20,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="QuayLai">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="10" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EEEEEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: THÔNG TIN SP -->
            <Border Grid.Column="0"
        Background="White"
        CornerRadius="16"
        Padding="16"
        Margin="8"
        BorderBrush="#E0E0E0"
        BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Thông tin sản phẩm"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#212121"
                       Margin="0,0,0,8"/>

                        <TextBlock Text="Vui lòng điền đầy đủ thông tin có dấu (*)" 
                       FontSize="11" FontStyle="Italic" 
                       Foreground="#757575" Margin="0,0,0,16"/>
                        <TextBlock Text="Mã sản phẩm" FontSize="12" FontWeight="Medium" 
                       Foreground="#424242" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtMaSP" Style="{StaticResource ModernTextBox}"
                     IsReadOnly="True" Background="#FAFAFA"
                     Text="{Binding SanPhamDangChon.MaSP}"/>
                        <TextBlock Text="Tên sản phẩm *" FontSize="12" FontWeight="Medium" 
                       Foreground="#424242" Margin="0,12,0,6"/>
                        <TextBox x:Name="txtTenSP" Style="{StaticResource ModernTextBox}"
                     Text="{Binding SanPhamDangChon.TenSP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Loại sản phẩm *" FontSize="12" FontWeight="Medium" 
                       Foreground="#424242" Margin="0,12,0,6"/>
                        <ComboBox x:Name="cboLoaiSP" Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding DanhSachLoaiSP}"
                      DisplayMemberPath="TenLoai"
                      SelectedValuePath="MaLoai"
                      SelectedValue="{Binding SanPhamDangChon.MaLoai, Mode=TwoWay}"/>
                        <TextBlock Text="Giá theo size *" FontSize="12" FontWeight="Medium" 
                       Foreground="#424242" Margin="0,12,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Size S" FontSize="11" Foreground="#757575" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtGiaS" Style="{StaticResource ModernTextBox}"
                             Text="{Binding SanPhamDangChon.GiaSizeS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Size M" FontSize="11" Foreground="#757575" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtGiaM" Style="{StaticResource ModernTextBox}"
                             Text="{Binding SanPhamDangChon.GiaSizeM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Size L" FontSize="11" Foreground="#757575" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtGiaL" Style="{StaticResource ModernTextBox}"
                             Text="{Binding SanPhamDangChon.GiaSizeL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số lượng tồn kho" FontSize="12" FontWeight="Medium" 
                               Foreground="#424242" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtSoLuongTon" Style="{StaticResource ModernTextBox}"
                             Text="{Binding SanPhamDangChon.SoLuongTon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="10" 
                        Padding="16,12" VerticalAlignment="Bottom" Height="44">
                                <CheckBox x:Name="chkTrangThai" 
                              Content="✓ Đang bán" 
                              FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32"
                              IsChecked="{Binding SanPhamDangChon.TrangThai, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Separator Margin="0,16"/>

                        <UniformGrid Rows="1" Columns="4">
                            <Button x:Name="btnThem" Content="Thêm" 
                        Background="#2E7D32" Style="{StaticResource ActionButton}"
                        Click="Them"/>
                            <Button x:Name="btnSua" Content="Sửa" 
                        Background="#F57C00" Style="{StaticResource ActionButton}"
                        Click="Sua"/>
                            <Button x:Name="btnXoa" Content="Xóa" 
                        Background="#C62828" Style="{StaticResource ActionButton}"
                        Click="Xoa"/>
                            <Button x:Name="btnLamMoi" Content="Làm Mới" 
                        Background="#1976D2" Style="{StaticResource ActionButton}"
                        Click="LamMoi"/>
                        </UniformGrid>

                    </StackPanel>
                </ScrollViewer>
            </Border>


            <!-- CỘT PHẢI -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Tìm kiếm và lọc">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="27.2"/>
                            <ColumnDefinition Width="184"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="0,0,3.8,0">
                            <TextBox x:Name="txtTimKiem" Height="44" BorderThickness="0"
                                     Background="Transparent" VerticalContentAlignment="Center"
                                     Padding="14,0" FontSize="13"
                                     Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,90,0"/>
                            <TextBlock Text="🔍 Tìm theo tên sản phẩm..." 
                                       FontSize="12" Foreground="#9E9E9E"
                                       IsHitTestVisible="False" Padding="14,0"
                                       VerticalAlignment="Center" Margin="0,10,158,10" Height="24">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtTimKiem}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox x:Name="cboLocLoai"
                                  Grid.Column="2"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding DanhSachLoaiLoc}"
                                  DisplayMemberPath="TenLoai"
                                  SelectedValuePath="MaLoai"
                                  SelectedValue="{Binding LoaiSPLoc, Mode=TwoWay}"/>

                        <TextBlock Grid.Column="4"
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#1976D2" VerticalAlignment="Center" Margin="10,10,10,14">
                            <Run Text="Tổng Sản Phẩm: "/>
                            <Run Text="{Binding TongSoSanPham}" FontSize="15" FontWeight="Bold"/>
                            <Run Text=" SP"/>
                        </TextBlock>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Danh sách sản phẩm">
                    <DataGrid ItemsSource="{Binding DanhSachSanPham}"
                              SelectedItem="{Binding SanPhamDangChon, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFAFA"
                              FontSize="13"
                              RowHeight="52">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#212121"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFF5F5"/>
                                        <Setter Property="Foreground" Value="#212121"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FAFAFA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding TenSP}" 
                                                Width="*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#212121"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Loại" Binding="{Binding LoaiSanPham.TenLoai}" Width="130"/>

                            <DataGridTextColumn Header="Giá S" Binding="{Binding GiaSizeS, StringFormat=N0}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Giá M" Binding="{Binding GiaSizeM, StringFormat=N0}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Giá L" Binding="{Binding GiaSizeL, StringFormat=N0}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Trạng thái" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="16" Padding="10,4" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                            <Setter Property="Background" Value="#FFEBEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✓ Bán"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                                <Setter Property="Text" Value="✕ Ngừng"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
