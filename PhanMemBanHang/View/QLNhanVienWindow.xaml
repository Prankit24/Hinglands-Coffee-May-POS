<Window x:Class="PhanMemBanHang.View.QLNhanVienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản Lý Nhân Viên - Highlands Coffee"
        WindowStartupLocation="CenterScreen"
        Height="750" Width="1400"
        MinHeight="700" MinWidth="1200"
        Background="#F8F9FA"
        WindowState="Maximized"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F5F5F5" 
                                        CornerRadius="10" Padding="14,10" 
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <ContentPresenter ContentSource="Header"
                                                          TextBlock.FontSize="14"
                                                          TextBlock.FontWeight="Bold"
                                                          TextBlock.Foreground="#212121"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"/>
                                        <ContentPresenter x:Name="PART_HeaderButtons" 
                                                          Content="{TemplateBinding Tag}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF5F5"/>
                    <Setter Property="BorderBrush" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="Foreground" Value="#D32F2F"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFCDD2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Input Styles -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#D32F2F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="28,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="50"
                        Height="50"
                        CornerRadius="25"
                        Background="#D32F2F"
                        Margin="0,0,16,0"
                        Padding="3">
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Image/logo.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>


                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUẢN LÝ NHÂN VIÊN" 
                                   FontSize="20" FontWeight="Bold" Foreground="#212121"/>
                        <TextBlock Text="Danh sách và thông tin nhân viên" 
                                   FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="2" Height="30" Background="#E0E0E0" Margin="12,0"/>

                    <Button Content="← Quay lại" 
                            Background="#F5F5F5" 
                            Foreground="#424242"
                            BorderThickness="0"
                            Padding="20,0"
                            Height="42"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="6,0"
                            Click="BtnQuayLai_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EEEEEE"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="📝 Thông tin nhân viên">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Vui lòng điền đầy đủ thông tin có dấu (*)" 
                                   FontSize="11" FontStyle="Italic" 
                                   Foreground="#757575" Margin="0,0,0,16"/>

                        <TextBlock Text="Mã nhân viên" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtMaNV"
                                 Text="{Binding NhanVienDangChon.MaNV, Mode=TwoWay}"
                                 IsEnabled="False" Background="#FAFAFA"/>

                        <TextBlock Text="Họ và tên *" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtHoTen"
                                 Text="{Binding NhanVienDangChon.HoTen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Tài khoản *" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtTaiKhoan"
                                 Text="{Binding NhanVienDangChon.TaiKhoan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Mật khẩu *" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtMatKhau"
                                 Text="{Binding NhanVienDangChon.MatKhau, Mode=TwoWay}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Vai trò *" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource InputComboBox}" x:Name="cbVaiTro"
                                          ItemsSource="{Binding DanhSachVaiTro}"
                                          SelectedItem="{Binding NhanVienDangChon.VaiTro, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Giới tính" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource InputComboBox}" x:Name="cbGioiTinh"
                                          ItemsSource="{Binding DanhSachGioiTinh}"
                                          SelectedItem="{Binding NhanVienDangChon.GioiTinh, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Ngày sinh" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <DatePicker Height="44" x:Name="dpNgaySinh" FontSize="13.5"
                                    SelectedDate="{Binding NhanVienDangChon.NgaySinh, Mode=TwoWay}"/>

                        <TextBlock Text="Số điện thoại" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtSDT"
                                 Text="{Binding NhanVienDangChon.SoDienThoai, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="15"/>

                        <TextBlock Text="Email" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtEmail"
                                 Text="{Binding NhanVienDangChon.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Địa chỉ" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtDiaChi"
                                 Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Padding="14,12"
                                 Text="{Binding NhanVienDangChon.DiaChi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Chức vụ" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <ComboBox Style="{StaticResource InputComboBox}" x:Name="cbChucVu"
                                  ItemsSource="{Binding DanhSachChucVu}"
                                  SelectedItem="{Binding NhanVienDangChon.ChucVu, Mode=TwoWay}"/>

                        <TextBlock Text="Ngày vào làm" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <DatePicker Height="44" x:Name="dpNgayVaoLam" FontSize="13.5"
                                    SelectedDate="{Binding NhanVienDangChon.NgayVaoLam, Mode=TwoWay}"/>

                        <TextBlock Text="Lương" FontSize="12" FontWeight="Medium" Foreground="#424242" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtLuong"
                                 Text="{Binding NhanVienDangChon.Luong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>

                        <Border Background="#E8F5E9" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                            <CheckBox Content="✓ Đang hoạt động" x:Name="checkBTrangThai"
                                      FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32"
                                      IsChecked="{Binding NhanVienDangChon.TrangThai, Mode=TwoWay}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="🔍 Tìm kiếm và lọc">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="2"
                                CornerRadius="10" Background="#FAFAFA">
                            <Grid>
                                <TextBox Height="44" BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Padding="14,0" FontSize="13"
                                         Background="Transparent"
                                         Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="🔍 Tìm kiếm theo tên, SĐT, email..." 
                                           FontSize="12" Foreground="#9E9E9E"
                                           IsHitTestVisible="False" Padding="14,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TuKhoaTimKiem}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="2" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding DanhSachLocVaiTro}"
                                  SelectedItem="{Binding VaiTroLoc}"
                                  SelectionChanged="LocVaiTro"/>

                        <ComboBox Grid.Column="4" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding DanhSachLocChucVu}"
                                  SelectedItem="{Binding ChucVuLoc}"
                                  SelectionChanged="LocChucVu"/>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="📊 Thống kê">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tổng nhân viên" FontSize="11" Foreground="#757575"/>
                            <TextBlock Text="{Binding TongSoNhanVien}" 
                                       FontSize="24" FontWeight="Bold" Foreground="#212121" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" BorderBrush="#F0F0F0" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Còn làm việc" FontSize="11" Foreground="#757575"/>
                                <TextBlock Text="{Binding SoNVDangHoatDong}" 
                                           FontSize="24" FontWeight="Bold" Foreground="#388E3C" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="#F0F0F0" BorderThickness="1,0,0,0" Padding="20,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Đã nghỉ việc" FontSize="11" Foreground="#757575"/>
                                <TextBlock Text="{Binding SoNVNgungHoatDong}" 
                                           FontSize="24" FontWeight="Bold" Foreground="#D32F2F" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="👥 Danh sách nhân viên">
                    <GroupBox.Tag>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➕ Thêm" Style="{StaticResource ActionButton}" Click="ThemMoi"/>
                            <Button Content="✏️ Sửa" Style="{StaticResource SecondaryButton}" Click="Sua"/>
                            <Button Content="🗑️ Xóa" Style="{StaticResource DeleteButton}" Click="Xoa"/>
                            <Button Content="🔄 Làm mới" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LamMoiCommand}"/>
                        </StackPanel>
                    </GroupBox.Tag>
                    <DataGrid ItemsSource="{Binding DanhSachNhanVien}"
                                  SelectedItem="{Binding NhanVienDangChon, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  FontSize="13"
                                  RowHeight="52">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#212121"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFF5F5"/>
                                        <Setter Property="Foreground" Value="#212121"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FAFAFA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*" MinWidth="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#212121"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Vai trò" Binding="{Binding VaiTro}" Width="90"/>
                            <DataGridTextColumn Header="Chức vụ" Binding="{Binding ChucVu}" Width="100"/>
                            <DataGridTextColumn Header="SĐT" Binding="{Binding SoDienThoai}" Width="110"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>

                            <DataGridTextColumn Header="Lương" Binding="{Binding Luong, StringFormat=N0}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Trạng thái" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="16" Padding="10,4" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                            <Setter Property="Background" Value="#FFEBEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✓ Hoạt động"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="False">
                                                                <Setter Property="Text" Value="✕ Ngừng"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>