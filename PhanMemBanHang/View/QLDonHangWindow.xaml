<Window x:Class="PhanMemBanHang.View.QLDonHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản Lý Đơn Hàng - Highlands Coffee"
        WindowStartupLocation="CenterScreen"
        Height="750" Width="1500"
        MinHeight="700" MinWidth="1400"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Giữ nguyên các Style từ QLHoaDonWindow -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#B22222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9A1C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#B22222"/>
            <Setter Property="BorderBrush" Value="#B22222"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF3F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputControl" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="20,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#B22222" CornerRadius="10" Width="45" Height="45" Margin="0,0,12,0">
                        <TextBlock Text="📋" FontSize="24" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUẢN LÝ ĐƠN HÀNG" 
                                   FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Quản lý đơn hàng theo Pager và trạng thái" 
                                   FontSize="11" Foreground="#7F8C8D"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="← Quay lại" 
                        HorizontalAlignment="Right"
                        Background="#FFEBEE" 
                        Foreground="#C62828"
                        BorderThickness="0"
                        Padding="15,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnQuayLai_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="8" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: BỘ LỌC & THỐNG KÊ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Thống kê -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="THỐNG KÊ NHANH" 
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,15"/>

                        <Border Style="{StaticResource StatCard}" Background="#FFF3E0" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="💰 Doanh thu hôm nay" FontSize="11" Foreground="#E65100"/>
                                <TextBlock Text="{Binding DoanhThuHomNay, StringFormat={}{0:N0} ₫}" 
                                           FontSize="20" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Background="#FFF9C4" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="⏳ Chờ xử lý" FontSize="10" Foreground="#F57C00"/>
                                    <TextBlock Text="{Binding DonChoXuLy, StringFormat={}{0} đơn}" 
                                               FontSize="16" FontWeight="Bold" Foreground="#F57C00" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Background="#E8F5E9" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="🔥 Đang làm" FontSize="10" Foreground="#2E7D32"/>
                                    <TextBlock Text="{Binding DonDangLam, StringFormat={}{0} đơn}" 
                                               FontSize="16" FontWeight="Bold" Foreground="#2E7D32" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource StatCard}" Background="#E3F2FD" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="📊 Tổng đơn hàng" FontSize="11" Foreground="#1565C0"/>
                                <TextBlock Text="{Binding TongSoDonHang, StringFormat={}{0} đơn}" 
                                           FontSize="20" FontWeight="Bold" Foreground="#1565C0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Bộ lọc -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="BỘ LỌC TÌM KIẾM" 
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#2C3E50" Margin="0,0,0,15"/>

                            <TextBlock Text="Từ khóa (Mã, Pager, KH)" 
                                       FontSize="12" Foreground="#555" Margin="0,5,0,5"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1.5" CornerRadius="8">
                                <TextBox Style="{StaticResource InputControl}"
                                         BorderThickness="0"
                                         Padding="12,0"
                                         Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <TextBlock Text="Từ ngày" 
                                       FontSize="12" Foreground="#555" Margin="0,15,0,5"/>
                            <DatePicker Style="{StaticResource InputControl}"
                                        SelectedDate="{Binding TuNgay, Mode=TwoWay}"
                                        SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                            <TextBlock Text="Đến ngày" 
                                       FontSize="12" Foreground="#555" Margin="0,10,0,5"/>
                            <DatePicker Style="{StaticResource InputControl}"
                                        SelectedDate="{Binding DenNgay, Mode=TwoWay}"
                                        SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                            <TextBlock Text="Trạng thái" 
                                       FontSize="12" Foreground="#555" Margin="0,15,0,5"/>
                            <ComboBox Style="{StaticResource InputControl}"
                                      ItemsSource="{Binding DanhSachTrangThai}"
                                      SelectedItem="{Binding TrangThaiLoc}"
                                      SelectionChanged="ComboBox_TrangThai_Changed"/>

                            <TextBlock Text="Phương thức thanh toán" 
                                       FontSize="12" Foreground="#555" Margin="0,10,0,5"/>
                            <ComboBox Style="{StaticResource InputControl}"
                                      ItemsSource="{Binding DanhSachPhuongThucTT}"
                                      SelectedItem="{Binding PhuongThucTTLoc}"
                                      SelectionChanged="ComboBox_PhuongThuc_Changed"/>

                            <TextBlock Text="Loại đơn" 
                                       FontSize="12" Foreground="#555" Margin="0,10,0,5"/>
                            <ComboBox Style="{StaticResource InputControl}"
                                      ItemsSource="{Binding DanhSachLoaiDon}"
                                      SelectedItem="{Binding LoaiDonLoc}"
                                      SelectionChanged="ComboBox_LoaiDon_Changed"/>

                            <TextBlock Text="Nhân viên" 
                                       FontSize="12" Foreground="#555" Margin="0,10,0,5"/>
                            <ComboBox Style="{StaticResource InputControl}"
                                      ItemsSource="{Binding DanhSachNhanVien}"
                                      DisplayMemberPath="HoTen"
                                      SelectedValuePath="MaNV"
                                      SelectedValue="{Binding NhanVienLoc}"
                                      SelectionChanged="ComboBox_NhanVien_Changed"/>

                            <Separator Margin="0,20,0,15"/>

                            <Button Content="🔍 Tìm kiếm" 
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding TimKiemCommand}"/>

                            <Button Content="🔄 Làm mới" 
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LamMoiCommand}"/>

                            <Button Content="📄 Xuất Excel" 
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding XuatExcelCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- RIGHT: DANH SÁCH ĐƠN HÀNG & CHI TIẾT -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="280"/>
                </Grid.RowDefinitions>

                <!-- Danh sách đơn hàng -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="DANH SÁCH ĐƠN HÀNG" 
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#2C3E50" VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Sắp xếp:" FontSize="12" Foreground="#555" 
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="150" Height="35" FontSize="12"
                                          ItemsSource="{Binding DanhSachSapXep}"
                                          SelectedItem="{Binding SapXepTheo}"
                                          SelectionChanged="ComboBox_SapXep_Changed"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="dgDonHang"
                                  ItemsSource="{Binding DanhSachDonHang}"
                                  SelectedItem="{Binding DonHangDangChon, Mode=TwoWay}"
                                  SelectionChanged="DgDonHang_SelectionChanged"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  FontSize="12">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFF3F3"/>
                                            <Setter Property="Foreground" Value="#2C3E50"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã HĐ" Binding="{Binding MaHD}" Width="70"/>
                                <DataGridTextColumn Header="Pager" Binding="{Binding TenPager}" Width="90"/>
                                <DataGridTextColumn Header="Ngày lập" Binding="{Binding NgayLap, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                                <DataGridTextColumn Header="Khách hàng" Binding="{Binding KhachHang}" Width="*" MinWidth="120"/>
                                <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="120"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding LoaiDon}" Width="80"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding TongSoLuong}" Width="50"/>
                                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat=N0}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B22222"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PT TT" Binding="{Binding PhuongThucTT}" Width="100"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="HoanThanh">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="ChoXuLy">
                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="DangLam">
                                                    <Setter Property="Foreground" Value="#1976D2"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="SanSang">
                                                    <Setter Property="Foreground" Value="#388E3C"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" 
                                Background="#F8F9FA" 
                                CornerRadius="8" 
                                Padding="12" 
                                Margin="0,10,0,0">
                            <Grid>
                                <TextBlock FontSize="12" Foreground="#555">
                                    <Run Text="Hiển thị:"/>
                                    <Run Text="{Binding DanhSachDonHang.Count}" FontWeight="SemiBold"/>
                                    <Run Text="đơn hàng"/>
                                </TextBlock>

                                <TextBlock FontSize="12" Foreground="#555" HorizontalAlignment="Right">
                                    <Run Text="Tổng giá trị:"/>
                                    <Run Text="{Binding TongGiaTriHienThi, StringFormat=N0}" FontWeight="Bold" Foreground="#B22222"/>
                                    <Run Text="₫"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chi tiết đơn hàng -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="CHI TIẾT ĐƠN HÀNG" 
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="#2C3E50" VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄 Cập nhật TT" 
                                        Style="{StaticResource SecondaryButton}"
                                        Height="35" Padding="15,0" Margin="0,0,5,0"
                                        Command="{Binding CapNhatTrangThaiCommand}"/>
                                <Button Content="🖨️ In phiếu" 
                                        Style="{StaticResource SecondaryButton}"
                                        Height="35" Padding="15,0"
                                        Command="{Binding InPhieuCommand}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DanhSachChiTiet}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFAFA"
                                  FontSize="12">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,6"/>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding TenSP}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="70"/>
                                <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat=N0}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B22222"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>