<Window x:Class="PhanMemBanHang.View.QLDonHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản Lý Đơn Hàng - Highlands Coffee"
        WindowStartupLocation="CenterScreen"
        Height="750" Width="1400"
        Background="#F8F9FA">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER đơn giản -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Background="#D32F2F" CornerRadius="8" Width="40" Height="40" Margin="0,0,10,0">
                    <TextBlock Text="📋"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="White"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="QUẢN LÝ ĐƠN HÀNG"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#212121"/>
                    <TextBlock Text="Quản lý đơn hàng theo Pager và trạng thái"
                               FontSize="12"
                               Foreground="#757575"/>
                </StackPanel>
            </StackPanel>

            <Button Content="← Quay lại"
                    DockPanel.Dock="Right"
                    Margin="10,0,0,0"
                    Padding="12,6"
                    Click="BtnQuayLai_Click"/>
        </DockPanel>

        <!-- NỘI DUNG CHÍNH: 2 CỘT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: THỐNG KÊ + LỌC -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <!-- THỐNG KÊ -->
                <GroupBox Header="Thống kê nhanh" Margin="0,0,0,10">
                    <StackPanel Margin="5">
                        <TextBlock Text="Doanh thu hôm nay" FontSize="12" Foreground="#555"/>
                        <TextBlock Text="{Binding DoanhThuHomNay, StringFormat={}{0:N0} ₫}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#D32F2F"
                                   Margin="0,2,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <StackPanel Width="140">
                                <TextBlock Text="Đơn chờ xử lý" FontSize="11" Foreground="#555"/>
                                <TextBlock Text="{Binding DonChoXuLy}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Width="140">
                                <TextBlock Text="Đơn đang làm" FontSize="11" Foreground="#555"/>
                                <TextBlock Text="{Binding DonDangLam}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Tổng số đơn hàng" Margin="0,8,0,0" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="{Binding TongSoDonHang}" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>

                <!-- BỘ LỌC -->
                <GroupBox Header="Bộ lọc tìm kiếm">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5">

                            <!-- Từ khóa -->
                            <TextBlock Text="Từ khóa" FontSize="12" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                     Height="26" Margin="0,0,0,8"/>

                            <!-- Từ ngày / đến ngày -->
                            <TextBlock Text="Từ ngày" FontSize="12" Margin="0,4,0,3"/>
                            <DatePicker SelectedDate="{Binding TuNgay}" Margin="0,0,0,8"/>

                            <TextBlock Text="Đến ngày" FontSize="12" Margin="0,4,0,3"/>
                            <DatePicker SelectedDate="{Binding DenNgay}" Margin="0,0,0,8"/>

                            <!-- Trạng thái -->
                            <TextBlock Text="Trạng thái" FontSize="12" Margin="0,4,0,3"/>
                            <ComboBox ItemsSource="{Binding DanhSachTrangThai}"
                                      SelectedItem="{Binding TrangThaiLoc}"
                                      Margin="0,0,0,8"/>

                            <!-- Phương thức TT -->
                            <TextBlock Text="Phương thức thanh toán" FontSize="12" Margin="0,4,0,3"/>
                            <ComboBox ItemsSource="{Binding DanhSachPhuongThucTT}"
                                      SelectedItem="{Binding PhuongThucTTLoc}"
                                      Margin="0,0,0,8"/>

                            <!-- Loại đơn -->
                            <TextBlock Text="Loại đơn" FontSize="12" Margin="0,4,0,3"/>
                            <ComboBox ItemsSource="{Binding DanhSachLoaiDon}"
                                      SelectedItem="{Binding LoaiDonLoc}"
                                      Margin="0,0,0,8"/>

                            <!-- Nhân viên -->
                            <TextBlock Text="Nhân viên" FontSize="12" Margin="0,4,0,3"/>
                            <ComboBox ItemsSource="{Binding DanhSachNhanVien}"
                                      DisplayMemberPath="HoTen"
                                      SelectedValuePath="MaNV"
                                      SelectedValue="{Binding NhanVienLoc}"
                                      Margin="0,0,0,8"/>

                            <!-- Nút -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Tìm kiếm"
                                        Margin="0,0,5,0"
                                        Padding="10,4"
                                        Click="BtnTimKiem_Click"/>
                                <Button Content="Làm mới"
                                        Padding="10,4"
                                        Click="BtnLamMoi_Click"/>
                            </StackPanel>

                            <Button Content="Xuất Excel"
                                    Margin="0,6,0,0"
                                    Padding="10,4"
                                    Click="BtnXuatExcel_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </StackPanel>

            <!-- CỘT PHẢI: DANH SÁCH + CHI TIẾT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="230"/>
                </Grid.RowDefinitions>

                <!-- DANH SÁCH ĐƠN -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- tiêu đề + sắp xếp -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Danh sách đơn hàng"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Sắp xếp:"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                            <ComboBox Width="150"
                                      ItemsSource="{Binding DanhSachSapXep}"
                                      SelectedItem="{Binding SapXepTheo}"
                                      SelectionChanged="ComboBox_SapXep_Changed"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid đơn -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DanhSachDonHang}"
                              SelectedItem="{Binding DonHangDangChon, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã HĐ" Binding="{Binding MaHD}" Width="70"/>
                            <DataGridTextColumn Header="Pager" Binding="{Binding TenPager}" Width="90"/>
                            <DataGridTextColumn Header="Ngày lập" Binding="{Binding NgayLap, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding KhachHang}" Width="*"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding NhanVien}" Width="130"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding LoaiDon}" Width="80"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding TongSoLuong}" Width="50"/>
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat={}{0:N0} ₫}" Width="130"/>
                            <DataGridTextColumn Header="PT TT" Binding="{Binding PhuongThucTT}" Width="100"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- footer -->
                    <DockPanel Grid.Row="2" Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" FontSize="12">
                            <Run Text="Hiển thị: "/>
                            <Run Text="{Binding DanhSachDonHang.Count,Mode=OneWay}"/>
                            <Run Text=" đơn hàng"/>
                        </TextBlock>

                        <TextBlock DockPanel.Dock="Right" FontSize="12">
                            <Run Text="Tổng giá trị: "/>
                            <Run Text="{Binding TongGiaTriHienThi, StringFormat={}{0:N0} ₫}"
                                 FontWeight="Bold"
                                 Foreground="#D32F2F"/>
                        </TextBlock>
                    </DockPanel>
                </Grid>

                <!-- CHI TIẾT ĐƠN -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Chi tiết đơn hàng"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Cập nhật trạng thái"
                                    Margin="0,0,5,0"
                                    Padding="10,4"
                                    Click="BtnCapNhatTrangThai_Click"/>
                            <Button Content="In phiếu"
                                    Padding="10,4"
                                    Click="BtnInPhieu_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DanhSachChiTiet}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding TenSP}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="60"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0} ₫}" Width="120"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0} ₫}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
